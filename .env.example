# Copy to .env and fill in real values. Never commit .env.

# TMDB API key (server-side only, mapped to private runtimeConfig.tmdbApiKey).
# Get one at https://www.themoviedb.org/settings/api (free account required).
NUXT_TMDB_API_KEY=your_key_here

# Host port the app is exposed on (docker-compose maps it to port 3000 in the container).
# Don't name this PORT: Nuxt reads PORT and would change its port inside the container.
HOST_PORT=3004
